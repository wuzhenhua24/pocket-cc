# ============================================================
# 必填：飞书自建应用凭据
# ============================================================
# 申请方式见 README.md §M0 设置步骤
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# 可选：通通有默认值，按需取消注释覆盖
# ============================================================

# 国际版飞书 (Lark) 改用 https://open.larksuite.com
# LARK_DOMAIN=https://open.feishu.cn

# Claude 工作目录。pocket-cc 启动的 Claude 会以这个目录为 cwd。
# 默认 ~/.pocket-cc/workspace（空目录，纯 demo 用）。
# 实际使用时改成你想让 Claude 操作的项目目录：
# POCKET_CC_WORKSPACE=/Users/you/Documents/gitpro/myproject

# Claude 启动命令。默认 `claude`，会按 Claude 自己的设置弹 permission 提示。
# 想跳过所有 permission 提示，改成下面这行（注意：sandbox 环境再用！会让 Claude
# 无确认执行 Bash/Edit/Write，详见 https://code.claude.com/docs/en/security）
# POCKET_CC_CLAUDE_COMMAND=claude --permission-mode bypassPermissions

# tmux session 名。默认 pocket-cc。多实例并跑时改这个区分。
# POCKET_CC_TMUX_SESSION=pocket-cc

# open_id 白名单，英文逗号分隔。空 = 所有人都能用（自用方便，多人部署必填）。
# POCKET_CC_USER_WHITELIST=ou_abc123,ou_def456

# 卡片 PATCH 节流间隔（秒）。飞书 PATCH ~5 QPS，留余量。
# POCKET_CC_PATCH_INTERVAL_S=1.5

# transcript 轮询间隔（秒）。M1-E 装 hooks 后可调高（hooks 走事件，不靠轮询）。
# POCKET_CC_TRANSCRIPT_POLL_S=0.5

# 是否在卡片里展示「💭 思考链」。默认关闭，让卡片贴近 tmux 终端（终端默认折叠思考）。
# 置 1/true 可展开 Claude 的思考原文（transcript 始终保留，这里只是渲染开关）。
# POCKET_CC_SHOW_THINKING=0
